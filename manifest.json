{
  "manifest_version": 3,
  "name": "AI Chat Exporter (DeepSeek, Grok, ChatGPT, Qwen)",
  "version": "2.0",
  "description": "Export your AI chats to Markdown — locally, privately, with one click.",
  "permissions": [
    "activeTab",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://twitter.com/i/grok*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.qwen.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Export AI chat to Markdown",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "128": "icons/128x128.png"
    }
  },
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "128": "icons/128x128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://twitter.com/i/grok*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.qwen.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}